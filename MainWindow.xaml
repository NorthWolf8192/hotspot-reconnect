<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root" Margin="28,20,28,22" TextElement.Foreground="{DynamicResource TextBrush}">
  <Grid.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="SecondaryText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" CornerRadius="5" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Grid>
                <Border x:Name="Hover" CornerRadius="4" Background="{DynamicResource HoverBrush}" Opacity="0"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter TargetName="Body" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Item" Background="Transparent" CornerRadius="4" Margin="4,2" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
              <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Box" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="5">
                  <Grid><Path Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Grid>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource RaisedBrush}"/></Trigger></ControlTemplate.Triggers>
              </ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="12,0,36,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock x:Name="Placeholder" Text="选择已保存的手机热点" Foreground="{DynamicResource MutedBrush}" Margin="12,0,36,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
            <Border x:Name="FocusLine" Height="2" CornerRadius="1" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" Margin="1,0,1,0" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="2,4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
                <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SelectedIndex" Value="-1"><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusLine" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="StateLabel" Text="关" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" Background="{DynamicResource SwitchBrush}" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1">
              <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="{DynamicResource MutedBrush}" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Border>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentTextBrush}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/><Setter TargetName="StateLabel" Property="Text" Value="开"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.8"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="22"/>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="20"/>
    <RowDefinition Height="*" MinHeight="130"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="热点自动重连" FontSize="28" FontWeight="SemiBold"/>
        <Border Background="{DynamicResource SelectionBrush}" CornerRadius="4" Padding="9,4" VerticalAlignment="Center" Margin="14,2,0,0">
          <TextBlock Text="唤醒时连接" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
        </Border>
      </StackPanel>
      <TextBlock Style="{StaticResource SecondaryText}" Text="离开时安心休眠，回来后继续连接。"/>
    </StackPanel>
    <Image x:Name="HeaderIcon" Grid.Column="1" Width="64" Height="64" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}">
    <StackPanel>
      <TextBlock Text="手机热点" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="选择电脑已保存的热点，无需重新输入密码。" Style="{StaticResource SecondaryText}" Margin="0,5,0,16"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="Profiles" AutomationProperties.Name="手机热点" ToolTip="选择已保存的手机热点及无线网卡"/>
        <Button x:Name="Refresh" Grid.Column="2" Content="刷新列表" AutomationProperties.Name="刷新热点列表"/>
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
        <Button x:Name="Start" Content="启用唤醒重连" Style="{StaticResource AccentButton}" MinWidth="154"/>
        <Button x:Name="Check" Content="立即检查" Margin="10,0,0,0" IsEnabled="False" MinWidth="112"/>
      </StackPanel>
      <Border Background="{DynamicResource StatusBrush}" BorderBrush="{DynamicResource StatusStrokeBrush}" BorderThickness="1" CornerRadius="5" Margin="0,18,0,0" Padding="13,11">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
          <TextBlock x:Name="Status" Grid.Column="1" Text="选择热点后，启用唤醒重连即可。" FontSize="12" TextWrapping="Wrap" LineHeight="19" MinHeight="20"/>
        </Grid>
      </Border>
    </StackPanel>
  </Border>
  <Border Grid.Row="4" Style="{StaticResource Card}" Padding="22,16">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1">
        <TextBlock Text="登录后自动启动" FontSize="14"/>
        <TextBlock Text="启动后留在托盘，等下次唤醒时检查。" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,18,0"/>
      </StackPanel>
      <CheckBox x:Name="Startup" Grid.Column="2" Style="{StaticResource Switch}" AutomationProperties.Name="登录 Windows 后自动启动"/>
    </Grid>
  </Border>
  <Grid Grid.Row="6">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="2,0,2,10">
      <TextBlock Text="活动记录" FontSize="14" FontWeight="SemiBold"/>
      <TextBlock Text="仅保留本次运行记录" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}" FontSize="11"/>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Background="{DynamicResource LogBrush}">
      <Grid>
        <TextBlock x:Name="EmptyLog" Text="尚无活动。启用后会在电脑唤醒时检查。" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,0"/>
        <TextBox x:Name="Log" IsReadOnly="True" IsReadOnlyCaretVisible="False" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="活动记录"/>
      </Grid>
    </Border>
  </Grid>
  <StackPanel Grid.Row="7" Margin="2,16,2,0">
    <TextBlock Text="唤醒后等待 5 秒 · 仅检查一次 · 手机热点需保持开启" Style="{StaticResource SecondaryText}" FontSize="11"/>
    <TextBlock Text="关闭窗口会收起到托盘；右键托盘图标可退出。" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,0,0"/>
  </StackPanel>
</Grid>
