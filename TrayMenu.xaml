<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}"
        Background="#08FFFFFF" Padding="6" TextElement.Foreground="{DynamicResource TextBrush}">
  <Border.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="39"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent" Padding="12,0">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.65"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Border.Resources>
  <StackPanel KeyboardNavigation.TabNavigation="Cycle">
    <Grid Margin="10,9,10,13">
      <Grid.ColumnDefinitions><ColumnDefinition Width="39"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Image x:Name="MenuIcon" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="热点自动重连" FontSize="13" FontWeight="SemiBold"/>
        <TextBlock x:Name="ModeLabel" Text="唤醒重连已暂停" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
      </StackPanel>
    </Grid>
    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="7,0,7,5"/>
    <Button x:Name="Open" AutomationProperties.Name="打开窗口">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE737;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
        <TextBlock Text="打开窗口" Grid.Column="1" VerticalAlignment="Center"/>
      </Grid>
    </Button>
    <Button x:Name="Toggle" AutomationProperties.Name="启用或暂停唤醒重连">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="ToggleIcon" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
        <TextBlock x:Name="ToggleLabel" Text="启用唤醒重连" Grid.Column="1" VerticalAlignment="Center"/>
      </Grid>
    </Button>
    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="7,5,7,5"/>
    <Button x:Name="Exit" AutomationProperties.Name="退出程序">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
        <TextBlock Text="退出程序" Grid.Column="1" VerticalAlignment="Center"/>
      </Grid>
    </Button>
  </StackPanel>
</Border>
